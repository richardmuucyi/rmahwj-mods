# What "a quality diagram" means, operationally.
# Six of the eight criteria are machine-checked by scripts/quality.py. The last two are
# printed anyway so a clean run is never mistaken for a finished diagram.
classes: {
  head: {
    style: {
      fill: "#0D1B3E"
      font-color: "#FFFFFF"
      stroke: "#0D1B3E"
      bold: true
    }
  }
  n: {
    style: {
      fill: "#F5F8FD"
      stroke: "#C7D2E5"
      bold: true
    }
  }
  c: {
    style: {
      fill: "#FFFFFF"
      stroke: "#C7D2E5"
    }
  }
  auto: {
    style: {
      fill: "#E4F1E8"
      stroke: "#1E6F45"
      bold: true
    }
  }
  human: {
    style: {
      fill: "#FDF1DF"
      stroke: "#B26B00"
      bold: true
    }
  }
}

title: What makes a diagram good {
  shape: text
  near: top-center
  style: {
    font-size: 28
    bold: true
  }
}

g: "" {
  grid-rows: 9
  grid-columns: 4
  grid-gap: 0

  h1: "#" {class: head}
  h2: Criterion {class: head}
  h3: How you check it {class: head}
  h4: Automated {class: head}

  a1: 1 {class: n}
  a2: It compiles {class: c}
  a3: Exit status, never the output file {class: c}
  a4: yes {class: auto}

  b1: 2 {class: n}
  b2: It drew what you meant {class: c}
  b3: Read the shapes back out of the SVG {class: c}
  b4: yes {class: auto}

  c1: 3 {class: n}
  c2: Nothing clipped or overlapping {class: c}
  c3: Measure it in a browser {class: c}
  c4: yes {class: auto}

  d1: 4 {class: n}
  d2: Labels are names {class: c}
  d3: Words per label {class: c}
  d4: yes {class: auto}

  e1: 5 {class: n}
  e2: It fits on a screen {class: c}
  e3: Canvas size and shape {class: c}
  e4: yes {class: auto}

  f1: 6 {class: n}
  f2: Style lives in one place {class: c}
  f3: Classes, not per-shape styling {class: c}
  f4: yes {class: auto}

  g1: 7 {class: n}
  g2: It answers one question {class: c}
  g3: Is there a title, and is it specific {class: c}
  g4: partly {class: human}

  i1: 8 {class: n}
  i2: It is honest {class: c}
  i3: Guesses marked as guesses {class: c}
  i4: no -- you {class: human}
}

foot: "Measure the first six.\nThe last two are why clean does not mean finished." {
  shape: text
  near: bottom-center
  style: {
    font-size: 17
    italic: true
  }
}
