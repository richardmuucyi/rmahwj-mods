# MIXED icon sources in one diagram: a local crest alongside hosted icons.
# There is no restriction against mixing -- `icon:` takes a relative path or a URL
# interchangeably, and both end up embedded as data URIs in the output.
#
# Prefer local wherever one exists: it cannot 403, needs no network at render time, and
# for anything with a brand or an organisation behind it, its own artwork is the correct
# mark rather than an approximation from a generic icon set. (The crest here is a
# fictional example: Northfield Library does not exist.)
direction: right

classes: {
  node: {
    width: 190
    height: 165
    style: {
      fill: "#FFFFFF"
      stroke: "#C7D2E5"
      border-radius: 10
    }
  }
  zone: {
    style: {
      fill: "#F5F8FD"
      stroke: "#AFC0DA"
    }
  }
  async: {
    style: {
      stroke: "#6A1B9A"
      stroke-dash: 4
    }
  }
}

title: City library -- local crest plus hosted infrastructure icons {
  shape: text
  near: top-center
  style: {
    font-size: 24
    bold: true
  }
}

library: "Northfield Library\nthe operator" {
  class: node
  icon: ./logos/library-crest.svg
  # Overrides the class deliberately. A detailed crest needs more room than a flat mark:
  # d2 fits the icon into whatever space the label leaves behind, so at the shared node
  # size the emblem came out muddy. An attribute set directly on an object beats its class.
  width: 210
  height: 240
}

branches: Branches {
  class: zone
  net: "Branch network\nB01 - B12" {
    class: node
    icon: https://icons.terrastruct.com/infra%2F019-network.svg
  }
}

platform: Platform {
  class: zone
  store: "Loan store" {
    class: node
    icon: https://icons.terrastruct.com/dev%2Fpostgresql.svg
  }
  stream: "Loan events" {
    class: node
    icon: https://icons.terrastruct.com/aws%2FAnalytics%2FAmazon-Kinesis.svg
  }
  archive: "Archive" {
    class: node
    icon: https://icons.terrastruct.com/infra%2F002-backup.svg
  }
}

library -> branches.net: operates
branches.net -> platform.store: writes loans
branches.net -> platform.stream: publishes {class: async}
platform.stream -> platform.archive: retained {class: async}
