# The starting class block as it stood before 2026-10-17: shape: person, and greys at 1.48 and 2.56.
classes: {
  actor: { shape: person; width: 52; height: 78
           style: { fill: "#64748b"; stroke: "#475569" } }
  svc:   { style: { fill: "#ffffff"; stroke: "#94a3b8"; border-radius: 6; font-size: 15 } }
  hot:   { style: { fill: "#eff6ff"; stroke: "#2563eb"; stroke-width: 2; border-radius: 6; bold: true } }
  store: { shape: cylinder; style: { fill: "#f8fafc"; stroke: "#94a3b8" } }
  zone:  { style: { fill: transparent; stroke: "#cbd5e1"; stroke-dash: 4; font-size: 13; font-color: "#64748b" } }
  flow:  { style: { stroke: "#2563eb"; stroke-width: 2; font-size: 12 } }
  quiet: { style: { stroke: "#cbd5e1"; stroke-width: 1; font-size: 12; font-color: "#94a3b8" } }
}
