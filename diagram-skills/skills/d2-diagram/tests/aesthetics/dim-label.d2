# Strokes all pass; labels do not. #8794a6 (3.08) is the boundary case: fine as a line, too faint as text.
classes: {
  svc:   { style: { stroke: "#7b8794"; font-color: "#94a3b8" } }
  zone:  { style: { stroke: "#8794a6"; font-color: "#8794a6" } }
  flow:  { style: { stroke: "#2563eb"; font-color: "#6b7280" } }
  quiet: { style: { stroke: "#8794a6"; font-color: gray } }
}
