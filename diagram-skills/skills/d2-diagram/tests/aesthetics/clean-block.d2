# Passing strokes among stroke-width and stroke-dash keys, which a loose match would misread as strokes.
classes: {
  svc:   { style: { fill: "#ffffff"; stroke: "#7b8794"; stroke-width: 1; border-radius: 6 } }
  zone:  { style: { fill: transparent; stroke: "#8794a6"; stroke-dash: 4; font-color: "#4b5563" } }
  flow:  { style: { stroke: "#2563eb"; stroke-width: 2; font-color: "#6b7280" } }
}
