# L5 -- a genre shape. Two rules that do not apply anywhere else in D2:
#   1. scope is FLAT -- every child of the diagram is the same actor everywhere
#   2. declaration ORDER is the layout -- actors left-to-right, messages top-to-bottom
# Actors used inside a group must be declared at top level first, which is why the
# three actors sit alone above the groups.
shape: sequence_diagram

client: Booking app
auth: Auth server
pay: Payments API

happy path: {
  client -> auth: "POST /token with client_id and secret"
  auth -> client: "access_token, expires in 3600s"
  client -> pay: "POST /charges with Bearer token"
  pay -> client: "201 charge created"
}

token expiry: {
  client -> pay: "POST /charges with a stale token"
  pay -> client: "401 Unauthorized"
  client -> auth: "POST /token again"
}

auth."Secret rotates every 90 days"
