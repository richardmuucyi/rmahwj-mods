# Shared palette, imported by the fixtures. The legend-honesty bug this corpus
# guards is caused BY sharing a palette: the classes travel between diagrams,
# the usage does not, so a copied legend claims encodings the body never uses.
classes: {
  svc:   {style: {fill: "#bfdbfe"; stroke: "#1d4ed8"}}
  store: {shape: cylinder; style: {fill: "#bbf7d0"; stroke: "#15803d"}}
  ext:   {style: {fill: "#e2e8f0"; stroke: "#64748b"; stroke-dash: 4}}
  group: {style: {stroke-dash: 3}}
}
