vars: { d2-config: { theme-id: 0; dark-theme-id: 200; pad: 40 } }
classes: {
  # zone from references/aesthetics.md, minus its font-color: a hex colour does not switch
  # under dark-theme-id, and #4b5563 is unreadable on the dark canvas. The theme colours it.
  zone: { style: { fill: transparent; stroke: "#8794a6"; stroke-dash: 5; font-size: 13 } }
  ext: { style.stroke-dash: 3 }
}
direction: right
title: "Link service context" { shape: text; near: top-center; style.font-size: 20 }
user: User { shape: image; icon: ./actor-outline.svg; width: 54; height: 54 }
boundary: Bitly {
  class: zone
  svc: "Link service\n[system]\nshortens and redirects"
}
analytics: "Analytics\n[external system]\ncounts clicks" { class: ext }
user -> boundary.svc: opens link
boundary.svc -> analytics: publishes clicks
